# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=campusconnect_super_secret_jwt_key_2026

# Google Gemini AI API Key
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Firebase Configuration (Optional for Google OAuth token verification)
FIREBASE_PROJECT_ID=campusconnect-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@campusconnect.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# OpenWeather API Key (Optional for live weather verification)
OPENWEATHER_API_KEY=your_openweather_api_key

# Cloudinary Image Storage (Optional)
CLOUDINARY_CLOUD_NAME=campusconnect
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=your_cloudinary_secret
